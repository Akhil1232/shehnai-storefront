# ---- Database (Neon / any Postgres) ----------------------------------
# Pooled connection, used by the app at runtime
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require&pgbouncer=true"
# Direct connection, used by `prisma migrate`
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# ---- Site ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Shehnai"

# ---- Razorpay --------------------------------------------------------
# Dashboard -> Settings -> API Keys. Use rzp_test_* while developing.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
# Dashboard -> Settings -> Webhooks. Any strong random string you also paste there.
RAZORPAY_WEBHOOK_SECRET="a-long-random-string"

# ---- Delhivery ---------------------------------------------------------
# Business API token from the Delhivery One dashboard (Settings -> API).
# Use the staging token/URL while testing; switch both to live before launch.
DELHIVERY_API_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
DELHIVERY_API_BASE_URL="https://staging-express.delhivery.com"
# Must exactly match a pickup location name already registered on the account.
DELHIVERY_PICKUP_LOCATION="Shehnai Warehouse"
# Warehouse/origin pincode — used to quote location-based freight charges at checkout.
DELHIVERY_ORIGIN_PINCODE="110001"
# Optional: only needed if your Delhivery account manages multiple "clients".
DELHIVERY_CLIENT_NAME=""

# ---- Cloudinary (image hosting; needed for the admin panel) ----------
CLOUDINARY_CLOUD_NAME="your-cloud"
CLOUDINARY_API_KEY="xxxxxxxxxxxx"
CLOUDINARY_API_SECRET="xxxxxxxxxxxx"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud"

# ---- Admin panel -----------------------------------------------------
# Any long random string. `openssl rand -base64 32` is a good way to make one.
AUTH_SECRET="change-me-to-a-long-random-string"

# ---- Self-hosting only ----------------------------------------------
# Shared secret for the cron endpoints. `openssl rand -hex 24`
CRON_SECRET="change-me"
